# Backend Environment Configuration Template
# Copy to .env and fill in your actual values

# Database
MONGO_URI=mongodb://localhost:27017/chillers

# Environment
NODE_ENV=development

# JWT & Admin Auth
JWT_SECRET=your_jwt_secret_change_me_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_change_me

# Streaming Providers
DOODSTREAM_API_KEY=your_doodstream_api_key
UQLOAD_API_KEY=your_uqload_api_key
STREAMTAPE_API_KEY=your_streamtape_api_key

# External APIs
SCRAPER_API_URL=http://localhost:4001
TMDB_API_KEY=your_tmdb_api_key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=admin@example.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
